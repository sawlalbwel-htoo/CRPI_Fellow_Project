### Food Insecurity by Gender 

library(readxl)
library(dplyr)
library(ggplot2)
library(lubridate)

# 1. Load data
df_mds <- read_excel("MDS_Dataset.xlsx", sheet = "Dataset")
names(df_mds) <- trimws(names(df_mds))

# 2. Process data for Food Insecurity
df_mds$Date <- as.Date(df_mds$Date)
df_mds$Food_Insecurity_Yes <- case_when(
  df_mds$`Food Insecurity` == 1 ~ 1,
  df_mds$`Food Insecurity` == 2 ~ 0,
  TRUE ~ NA_real_
)

df_clean <- df_mds %>% 
  filter(!is.na(Date), !is.na(Food_Insecurity_Yes)) %>%
  mutate(
    Gender_Label = factor(Gender, levels = c(1, 2), labels = c("Male", "Female")),
    Period_Feb2023 = if_else(Date >= as.Date("2023-02-01"), "Post-Feb 2023", "Pre-Feb 2023")
  )

# 3. Calculate monthly means by gender and period
monthly_means_by_gender <- df_clean %>%
  mutate(Month_Year = floor_date(Date, "month")) %>%
  group_by(Month_Year, Gender_Label, Period_Feb2023) %>%
  summarize(
    Monthly_Mean = mean(Food_Insecurity_Yes, na.rm = TRUE),
    Observation_Count = n(),
    .groups = "drop"
  )

# 4. Calculate average means (reference lines) for each gender & period
avg_means_by_gender <- df_clean %>%
  group_by(Gender_Label, Period_Feb2023) %>%
  summarize(
    Average_Mean = mean(Food_Insecurity_Yes, na.rm = TRUE),
    .groups = "drop"
  )

# Merge average mean back into monthly data
mn_avgmn_by_gender <- monthly_means_by_gender %>%
  left_join(avg_means_by_gender, by = c("Gender_Label", "Period_Feb2023"))

# 5. Refined ggplot visualization for Food Insecurity
ggplot(mn_avgmn_by_gender, aes(x = Month_Year, y = Monthly_Mean)) +
  geom_line(color = "#0052cc", linewidth = 1) +
  geom_point(color = "#0052cc", size = 2) +
  # Horizontal dashed line representing the average mean for each subgroup/period
  geom_hline(aes(yintercept = Average_Mean), color = "green", linetype = "dashed", linewidth = 1) +
  # Facet grid separating Gender (rows) and Period (columns)
  facet_grid(Gender_Label ~ Period_Feb2023, scales = "free_x") +
  labs(
    title = "Proportion of Food Insecurity Reporting by Gender",
    subtitle = "Green dashed lines = Subgroup Average Mean",
    x = "Month",
    y = "Proportion of Food Insecurity (Yes = 1)"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    strip.text = element_text(face = "bold", size = 11)
  )

