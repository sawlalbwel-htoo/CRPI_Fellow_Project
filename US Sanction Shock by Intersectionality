library(readxl)
library(dplyr)
library(ggplot2)
library(lubridate)

# Set workign directory 
setwd("C:/Users/")

# Load data
df_mds <- read_excel("MDS_Dataset.xlsx", sheet = "Dataset")

# Clean column names (strip whitespace)
names(df_mds) <- trimws(names(df_mds))

# 2. Process data
df_mds$Date <- as.Date(df_mds$Date)
df_mds$Food_Insecurity_Yes <- case_when(
  df_mds$`Food Insecurity` == 1 ~ 1,
  df_mds$`Food Insecurity` == 2 ~ 0,
  TRUE ~ NA_real_
)

# Filter valid rows
df_clean <- df_mds %>% 
  filter(!is.na(Date), !is.na(Food_Insecurity_Yes))

###Household reporting Food Insecurity 

# Table 1: Summary Statistics by Gender
summary_by_gender <- df_clean %>%
  mutate(Gender_Label = factor(Gender, levels = c(1, 2), labels = c("Male", "Female"))) %>%
  group_by(Gender_Label) %>%
  summarize(
    Observation_Count = n(),
    Mean = mean(Food_Insecurity_Yes, na.rm = TRUE),
    Std_Dev = sd(Food_Insecurity_Yes, na.rm = TRUE),
    Min = min(Food_Insecurity_Yes, na.rm = TRUE),
    Max = max(Food_Insecurity_Yes, na.rm = TRUE)
  )

print("=== Summary Statistics by Gender ===")
print(summary_by_gender)


# Table 2: Summary Statistics by Sanction Period (Pre vs Post Feb 2023)
summary_by_period <- df_clean %>%
  mutate(Period = if_else(Date >= as.Date("2023-02-01"), "Post-Sanction (Feb 2023+)", "Pre-Sanction")) %>%
  group_by(Period) %>%
  summarize(
    Observation_Count = n(),
    Mean = mean(Food_Insecurity_Yes, na.rm = TRUE),
    Std_Dev = sd(Food_Insecurity_Yes, na.rm = TRUE),
    Min = min(Food_Insecurity_Yes, na.rm = TRUE),
    Max = max(Food_Insecurity_Yes, na.rm = TRUE)
  )

print("=== Summary Statistics by Sanction Period ===")
print(summary_by_period)

# Calculate monthly mean
monthly <- df_clean %>%
  mutate(Month_Year = floor_date(Date, "month")) %>%
  group_by(Month_Year) %>%
  summarize(mean = mean(Food_Insecurity_Yes), count = n())

# Calculate overall mean
avg_mean <- mean(df_clean$Food_Insecurity_Yes)

# 3. Plotting
ggplot(monthly, aes(x = Month_Year, y = mean)) +
  geom_line(color = "#0052cc", linewidth = 1) +
  geom_point(color = "#0052cc", size = 2) +
  geom_hline(yintercept = avg_mean, color = "green", linetype = "solid", linewidth = 1) +
  geom_vline(xintercept = as.Date("2023-02-01"), color = "red", linetype = "dashed", linewidth = 1) +
  labs(
    title = "Proportion of Households Reporting Severe Food Insecurity over Time",
    subtitle = paste0("Overall Average: ", round(avg_mean, 3)),
    x = "Date",
    y = "Proportion (Yes = 1)"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

