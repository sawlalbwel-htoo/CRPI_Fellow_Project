library(readxl)
library(dplyr)
library(ggplot2)
library(lubridate)

# 1. Load data
df_mds <- read_excel("MDS_Dataset.xlsx", sheet = "Dataset")
names(df_mds) <- trimws(names(df_mds))

# 2. Process data for Economic Shocks (J15_00 to J15_07)
df_mds$Date <- as.Date(df_mds$Date)

df_clean <- df_mds %>%
  # FIX: Coerce all J15 columns to numeric first to prevent type-matching errors
  mutate(across(starts_with("J15_"), as.numeric)) %>%
  # Replace 9997 with NA across all J15 columns
  mutate(across(starts_with("J15_"), ~ na_if(., 9997))) %>%
  # Calculate row-wise aggregate (How many shocks out of 8 did they face?)
  rowwise() %>%
  mutate(
    Economic_Shock_Count = if_else(
      all(is.na(c_across(starts_with("J15_")))), 
      NA_real_, 
      sum(c_across(starts_with("J15_")), na.rm = TRUE)
    )
  ) %>%
  ungroup() %>%
  # Filter valid rows
  filter(!is.na(Date), !is.na(Economic_Shock_Count))

### Household reporting Economic Shocks (Count Index)

# Table 1: Summary Statistics by Gender
summary_by_gender <- df_clean %>%
  mutate(Gender_Label = factor(Gender, levels = c(1, 2), labels = c("Male", "Female"))) %>%
  group_by(Gender_Label) %>%
  summarize(
    Observation_Count = n(),
    Mean_Shocks = mean(Economic_Shock_Count, na.rm = TRUE),
    Std_Dev = sd(Economic_Shock_Count, na.rm = TRUE),
    Min = min(Economic_Shock_Count, na.rm = TRUE),
    Max = max(Economic_Shock_Count, na.rm = TRUE)
  )

print("=== Summary Statistics by Gender (Economic Shock Count) ===")
print(summary_by_gender)


# Table 2: Summary Statistics by Sanction Period (Pre vs Post Feb 2023)
summary_by_period <- df_clean %>%
  mutate(Period = if_else(Date >= as.Date("2023-02-01"), "Post-Sanction (Feb 2023+)", "Pre-Sanction")) %>%
  group_by(Period) %>%
  summarize(
    Observation_Count = n(),
    Mean_Shocks = mean(Economic_Shock_Count, na.rm = TRUE),
    Std_Dev = sd(Economic_Shock_Count, na.rm = TRUE),
    Min = min(Economic_Shock_Count, na.rm = TRUE),
    Max = max(Economic_Shock_Count, na.rm = TRUE)
  )

print("=== Summary Statistics by Sanction Period (Economic Shock Count) ===")
print(summary_by_period)


# Calculate monthly mean
monthly <- df_clean %>%
  mutate(Month_Year = floor_date(Date, "month")) %>%
  group_by(Month_Year) %>%
  summarize(mean = mean(Economic_Shock_Count), count = n())

# Calculate overall mean
avg_mean <- mean(df_clean$Economic_Shock_Count)


# 3. Plotting
ggplot(monthly, aes(x = Month_Year, y = mean)) +
  geom_line(color = "#e67e22", linewidth = 1) +
  geom_point(color = "#e67e22", size = 2) +
  geom_hline(yintercept = avg_mean, color = "green", linetype = "solid", linewidth = 1) +
  geom_vline(xintercept = as.Date("2023-02-01"), color = "red", linetype = "dashed", linewidth = 1) +
  labs(
    title = "Average Number of Economic Shocks Reported over Time",
    subtitle = paste0("Overall Average: ", round(avg_mean, 2), " concurrent shocks"),
    x = "Date",
    y = "Average Number of Shocks (Scale: 1-8)"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

